APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Where the services answer. The gateway forwards to these; nothing else should
# be able to reach them. Origins only, no /api suffix -- see config/gateway.php.
WEBSITE_SERVICE_URL=http://127.0.0.1:8001
SHOP_SERVICE_URL=http://127.0.0.1:8002
THIRDPARTY_SERVICE_URL=http://127.0.0.1:8003

# Seconds to wait on a service before answering 502.
GATEWAY_TIMEOUT=10

# What GET /api/status pings on each service, and how hard it tries. The path
# is Laravel's own health route, which answers without a token or a database.
# Shorter timeout than the forwarding one above -- a status page asks three
# services at once -- and answers are reused for TTL seconds so polling it is
# cheap.
GATEWAY_HEALTH_PATH=/up
GATEWAY_HEALTH_TIMEOUT=3
GATEWAY_HEALTH_TTL=10

# Proves a request came from the gateway.
#
# The JWT proves who is calling; this proves what is calling, and unlike the
# JWT it is on every request -- the public storefront routes carry no token at
# all, so without this a service has nothing to check them against. The
# gateway sends it as X-Gateway-Token on every forward; each service compares
# it and answers 403 if it is absent or wrong.
#
# Same value in the gateway and all three services. It is not a user
# credential and never reaches a browser: rotate it by changing it in all four
# and restarting, in any order -- a mismatch fails closed.
GATEWAY_TOKEN=

# ---------------------------------------------------------------------------
# Serving the frontend, with an article's metadata already in the HTML
# ---------------------------------------------------------------------------
#
# vue-vite renders in the browser, so the document it ships carries no title,
# no description and no share card -- a social scraper runs no JavaScript and
# sees an empty page. The gateway writes those tags into index.html before
# serving it. See config/seo.php and the README.

# Where the built frontend lives. Unset, the first of public/ then
# vue-vite/dist/ that holds an index.html is used -- so copying dist/* into the
# public root needs no configuration at all.
SPA_ROOT=

# The origin canonical URLs are built on. Empty means "the host the request
# arrived on", which is right for one deployment behind one name. Set it once
# the site has a domain, or the same page is canonical under several hosts.
SEO_BASE_URL=

# The slugs the frontend serves. Must match CATALOG_SLUGS in
# vue-vite/src/shared/config/sites.ts.
SEO_SITEMAP_SLUGS=installer,ev

# Seconds an article, a website and the portal are held before being read
# again. A crawl is otherwise a flood of identical reads at website-service.
SEO_CACHE_TTL=300
